rules_version = '2';

// Toutes les mutations de jeu (or, XP, loot, combat...) passent par les routes
// API du serveur avec firebase-admin, qui ignore ces règles. Le client ne peut
// donc que LIRE ses propres données ; aucune écriture directe n'est autorisée
// depuis le navigateur, ce qui empêche de truquer son état de jeu.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(ownerId) {
      return request.auth != null && request.auth.uid == ownerId;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /heroes/{heroId} {
      allow read: if isOwner(resource.data.ownerId);
      allow write: if false;
    }

    match /items/{itemId} {
      allow read: if isOwner(resource.data.ownerId);
      allow write: if false;
    }

    match /dungeons/{uid} {
      // Le layout caché est le coeur du gameplay d'attaque (brouillard de
      // guerre) : seul le propriétaire peut le lire. Les cibles de raid sont
      // servies via /api/dungeon/targets (admin SDK), qui ne renvoie que des
      // statistiques agrégées, jamais le layout brut.
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /dungeonUpgrades/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /dungeonRaids/{raidId} {
      // Jamais lisible côté client, même par son propriétaire : le brouillard
      // de guerre ne peut pas être garanti par des règles sur un état
      // imbriqué, donc le document ne doit jamais sortir du serveur. Le
      // client ne voit que la projection filtrée renvoyée par les routes API.
      allow read: if false;
      allow write: if false;
    }

    match /expeditions/{expeditionId} {
      allow read: if isOwner(resource.data.ownerId);
      allow write: if false;
    }
  }
}
